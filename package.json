{
  "name": "lozchart",
  "version": "0.1.0",
  "description": "Librería de gráficos SVG interactivos, accesibles y sin dependencias.",
  "type": "module",
  "main": "./dist/lozchart.umd.js",
  "module": "./dist/lozchart.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lozchart.js",
      "require": "./dist/lozchart.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc --noEmit && vite build && LC_FORMAT=umd vite build && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/core.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/core.test.mjs && node node_modules/.cache/core.test.mjs"
  },
  "keywords": [
    "charts",
    "svg",
    "graficos",
    "dataviz"
  ],
  "author": "Mayra Lozada",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
