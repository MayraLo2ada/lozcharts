{
  "name": "lozcharts",
  "version": "1.1.0",
  "description": "Gráficos para la web: 26 tipos accesibles (teclado, lector de pantalla, daltonismo), claro y oscuro, zoom, mapas y globo, sin dependencias. Para HTML, React, Angular, Vue, Svelte y Django + HTMX.",
  "type": "module",
  "main": "./dist/lozcharts.umd.cjs",
  "module": "./dist/lozcharts.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lozcharts.js",
      "require": "./dist/lozcharts.umd.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./maps/world": {
      "types": "./dist/types/maps/register-world.d.ts",
      "import": "./dist/maps/world.js",
      "require": "./dist/maps/world.cjs"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "maps/LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc --noEmit && vite build && LC_FORMAT=umd vite build && LC_FORMAT=react vite build && LC_FORMAT=element vite build && LC_FORMAT=world vite build && LC_FORMAT=world-umd vite build && LC_FORMAT=world-cjs vite build && cp dist/lozcharts.umd.js dist/lozcharts.umd.cjs && tsc -p tsconfig.types.json",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.pruebas --log-level=warning && node --test \".pruebas/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && npm test",
    "example:react": "esbuild examples/react/App.tsx --bundle --jsx=automatic --alias:lozcharts/react=./src/react.ts --alias:lozcharts=./src/index.ts --define:process.env.NODE_ENV=\\\"production\\\" --minify --outfile=examples/react/dist/app.js",
    "prepare": "npm run build",
    "site": "npm run build && node scripts/sitio.mjs"
  },
  "keywords": [
    "charts",
    "graficos",
    "svg",
    "dataviz",
    "visualizacion",
    "accesible",
    "react",
    "web-components",
    "htmx",
    "maps"
  ],
  "author": "Mayra Lozada",
  "homepage": "https://mayralo2ada.github.io/lozcharts/",
  "bugs": "https://github.com/MayraLo2ada/lozcharts/issues",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.21.5",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MayraLo2ada/lozcharts.git"
  }
}
