{
  "name": "@lozcharts/core",
  "version": "1.1.0",
  "description": "Charts for the web: 26 accessible types (keyboard, screen reader, color-blind safe), light and dark mode, zoom, maps and a globe, zero dependencies. Works with plain HTML, React, Angular, Vue, Svelte and Django + HTMX. Docs in English, Spanish and Portuguese.",
  "type": "module",
  "main": "./dist/lozcharts.umd.cjs",
  "module": "./dist/lozcharts.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/lozcharts.umd.js",
  "jsdelivr": "./dist/lozcharts.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/lozcharts.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/lozcharts.umd.cjs"
      }
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "default": "./dist/element.js"
    },
    "./maps/world": {
      "import": {
        "types": "./dist/types/maps/register-world.d.ts",
        "default": "./dist/maps/world.js"
      },
      "require": {
        "types": "./dist/types/maps/register-world.d.cts",
        "default": "./dist/maps/world.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/types/react.d.ts"
      ],
      "element": [
        "./dist/types/element.d.ts"
      ],
      "maps/world": [
        "./dist/types/maps/register-world.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "maps/LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc --noEmit && vite build && LC_FORMAT=umd vite build && LC_FORMAT=react vite build && LC_FORMAT=element vite build && LC_FORMAT=world vite build && LC_FORMAT=world-umd vite build && LC_FORMAT=world-cjs vite build && cp dist/lozcharts.umd.js dist/lozcharts.umd.cjs && tsc -p tsconfig.types.json && node scripts/tipos.mjs",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.pruebas --log-level=warning && node --test \".pruebas/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && npm test",
    "example:react": "esbuild examples/react/App.tsx --bundle --jsx=automatic --alias:@lozcharts/core/react=./src/react.ts --alias:@lozcharts/core=./src/index.ts --define:process.env.NODE_ENV=\\\"production\\\" --minify --outfile=examples/react/dist/app.js",
    "prepare": "npm run build",
    "site": "npm run build && node scripts/sitio.mjs"
  },
  "keywords": [
    "charts",
    "chart",
    "graph",
    "graficos",
    "graficas",
    "grafico",
    "svg",
    "dataviz",
    "data-visualization",
    "visualizacion",
    "visualizacao",
    "graficos-acessiveis",
    "accessibility",
    "a11y",
    "accesible",
    "acessivel",
    "i18n",
    "dark-mode",
    "typescript",
    "react",
    "angular",
    "vue",
    "svelte",
    "web-components",
    "custom-element",
    "htmx",
    "django",
    "maps",
    "choropleth",
    "sankey",
    "treemap",
    "candlestick",
    "timeline"
  ],
  "author": "Mayra Lozada",
  "homepage": "https://mayralo2ada.github.io/lozcharts/",
  "bugs": "https://github.com/MayraLo2ada/lozcharts/issues",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.21.5",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MayraLo2ada/lozcharts.git"
  }
}
