{
  "name": "lozcharts",
  "version": "0.1.0",
  "description": "LozCharts: gráficos SVG interactivos, accesibles y sin dependencias.",
  "type": "module",
  "main": "./dist/lozcharts.umd.js",
  "module": "./dist/lozcharts.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lozcharts.js",
      "require": "./dist/lozcharts.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc --noEmit && vite build && LC_FORMAT=umd vite build && tsc -p tsconfig.types.json",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.pruebas --log-level=warning && node --test \".pruebas/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && npm test"
  },
  "keywords": [
    "charts",
    "svg",
    "graficos",
    "dataviz"
  ],
  "author": "Mayra Lozada",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.21.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MayraLo2ada/lozcharts.git"
  }
}
